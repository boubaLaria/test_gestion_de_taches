generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider ="postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  tasks     Task[]
}

model Task {
  id        Int      @id @default(autoincrement())
  name      String
  status    String
  userId    Int?
  user      Users?   @relation(fields: [userId], references: [id])
}
